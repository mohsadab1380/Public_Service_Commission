<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="dashboardPane" prefHeight="680.0" prefWidth="1080.0" style="-fx-background-color: #f2f5f9;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="User_2411699_Controller.AccountantDashboardController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #1f3a5f;">
            <padding>
                <Insets bottom="14.0" left="20.0" right="20.0" top="14.0" />
            </padding>
            <Label style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" text="Accountant Dashboard" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="userLabel" prefHeight="17.0" prefWidth="64.0" style="-fx-text-fill: white;" text="Name/ID" />
            <Button onAction="#onLogOutClick" text="Log Out" />
        </HBox>
    </top>

    <left>
        <VBox prefWidth="250.0" spacing="6.0" style="-fx-background-color: white;">
            <padding>
                <Insets bottom="16.0" left="14.0" right="14.0" top="16.0" />
            </padding>
            <Label style="-fx-font-weight: bold;" text="Menu" />
            <Button maxWidth="Infinity" onAction="#onFeeReconciliationClick" text="Fee Verification" />
            <Button maxWidth="Infinity" onAction="#onPayrollClick" text="Payroll Management" />
            <Button maxWidth="Infinity" onAction="#onSupplierPaymentClick" text="Supplier Payment Management" />
            <Button maxWidth="Infinity" onAction="#onBudgetClick" text="Budget Management" />
            <Button maxWidth="Infinity" onAction="#onFinancialReportsClick" text="Financial Reports" />
            <Button maxWidth="Infinity" onAction="#onExaminationPaymentsClick" text="Examination Payments" />
            <Button maxWidth="Infinity" onAction="#onTaxComplianceClick" text="Tax and VAT Compliance" />
            <Button maxWidth="Infinity" onAction="#onAuditSupportClick" text="Audit Support" />
        </VBox>
    </left>

    <center>
        <VBox alignment="CENTER" spacing="10.0">
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Welcome to the Accountant Dashboard" />
            <Label text="Select a module from the menu to start working." />
        </VBox>
    </center>
</BorderPane>
