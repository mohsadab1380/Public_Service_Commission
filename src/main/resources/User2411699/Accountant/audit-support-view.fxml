<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="User_2411699_Controller.AuditSupportController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <Button mnemonicParsing="false" onAction="#OnClickDashboard" text="Dashboard" />

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Audit Support" />
   <AnchorPane prefHeight="200.0" prefWidth="200.0">
      <children>
         <Label layoutX="39.0" layoutY="15.0" text="Voucher Id:" />
         <Label layoutX="20.0" layoutY="52.0" text="Transaction Id:" />
         <Label layoutX="46.0" layoutY="91.0" text="Amount:" />
         <TextField fx:id="voucherIdTextField" layoutX="110.0" layoutY="11.0" />
         <TextField fx:id="TransactionIdTextField" layoutX="110.0" layoutY="48.0" />
         <TextField fx:id="AmountTextField" layoutX="110.0" layoutY="87.0" />
         <Button layoutX="110.0" layoutY="153.0" mnemonicParsing="false" onAction="#OnClickAddAuditRec" text="Add to Audit Record" />
         <RadioButton fx:id="StatusCompleted" layoutX="39.0" layoutY="121.0" mnemonicParsing="false" text="Completed">
            <toggleGroup>
               <ToggleGroup fx:id="AuditStatus" />
            </toggleGroup>
         </RadioButton>
         <RadioButton fx:id="StatusPending" layoutX="272.0" layoutY="121.0" mnemonicParsing="false" text="Pending" toggleGroup="$AuditStatus" />
      </children>
   </AnchorPane>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button onAction="#onLoadClick" text="Load Audit Records" />
        <Button onAction="#onGenerateClick" text="Generate Audit Report" />
        <Button onAction="#onUpdateClick" text="Update Financial Records" />
        <Button onAction="#onCompleteClick" text="Complete Audit Support" />
    </HBox>

    <TableView fx:id="auditTable" prefHeight="180.0">
        <columns>
            <TableColumn fx:id="voucherIdColumn" prefWidth="120.0" text="Voucher ID" />
            <TableColumn fx:id="transactionIdColumn" prefWidth="151.3333282470703" text="Transaction ID" />
            <TableColumn fx:id="amountColumn" prefWidth="150.66668701171875" text="Amount" />
            <TableColumn fx:id="auditStatusColumn" prefWidth="157.33334350585938" text="Audit Status" />
        </columns>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="10.0" />

    <Label fx:id="validationLabel" prefHeight="17.0" prefWidth="51.0" style="-fx-text-fill: #b00020;" text="Label" wrapText="true" />

    <Label fx:id="statusLabel" style="-fx-text-fill: #1b7f4b; -fx-font-weight: bold;" text="Label" />
</VBox>
