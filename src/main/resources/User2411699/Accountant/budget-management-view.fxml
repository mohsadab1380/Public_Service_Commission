<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="user_2411699_controller.BudgetManagementController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <Button mnemonicParsing="false" onAction="#OnDashboardClick" text="Dashboard" textFill="#2c4fff" />

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Budget Management" />
   <AnchorPane prefHeight="93.0" prefWidth="871.0">
      <children>
         <Label layoutX="49.0" layoutY="25.0" text="Allocated Budget:" />
         <Label layoutX="49.0" layoutY="61.0" text="Used Budget:" />
         <TextField fx:id="AllocatedBUdgetTextfield" layoutX="160.0" layoutY="21.0" />
         <TextField fx:id="UsedBudgetTextField" layoutX="160.0" layoutY="57.0" />
      </children>
   </AnchorPane>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Department" />
        <ComboBox fx:id="departmentComboBox" prefWidth="180.0" />
        <Button onAction="#onSearchClick" text="Load Budget Records" />
        <Button onAction="#onGenerateReportClick" text="Generate Budget Utilization Report" />
    </HBox>

    <Label style="-fx-font-weight: bold;" text="Budget Records" />
    <TableView fx:id="budgetTable" prefHeight="150.0">
        <columns>
            <TableColumn fx:id="departmentColumn" prefWidth="275.33338356018066" text="Department Name" />
            <TableColumn fx:id="allocatedColumn" prefWidth="263.3332824707031" text="Allocated Budget" />
            <TableColumn fx:id="usedColumn" prefWidth="331.99993896484375" text="Used Budget" />
        </columns>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="10.0" />
    <Label fx:id="statusLabel" style="-fx-text-fill: #1b7f4b; -fx-font-weight: bold;" text="satus" />
</VBox>
