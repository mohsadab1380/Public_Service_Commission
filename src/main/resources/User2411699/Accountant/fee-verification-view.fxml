<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="user_2411699_controller.FeeVerificationController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <Button mnemonicParsing="false" onAction="#OnClickDashboard" style="-fx-background-color: Skyblue;" text="Dashboard" textFill="#333232" />

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Exam Fee Verification" />

    <HBox alignment="CENTER_LEFT" spacing="10.0">
      <Label text="Request ID:" />
      <TextField fx:id="applicantIdTextfField" prefHeight="25.0" prefWidth="87.0" />
        <Button onAction="#onSearchClick" text="Search" />
        <Button onAction="#onVerifyClick" text="Verify Payment Records" />
        <Button onAction="#onConfirmClick" text="Confirm Verification" />
    </HBox>

    <TableView fx:id="transactionTable" prefHeight="240.0">
        <columns>
            <TableColumn fx:id="applicantIdColumn" prefWidth="120.0" text="Request ID" />
            <TableColumn fx:id="ExamTypeColumn" prefWidth="160.0" text="Examination Type" />
            <TableColumn fx:id="amountColumn" prefWidth="131.99996948242188" text=" Amount" />
            <TableColumn fx:id="statusColumn" prefWidth="149.3333740234375" text="Payment Status" />
        </columns>
    </TableView>

    <Label fx:id="statusLabel" prefHeight="17.0" prefWidth="84.0" style="-fx-text-fill: #1b7f4b; -fx-font-weight: bold;" />
</VBox>
