<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="User_2411699_Controller.FinancialReportsController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <Button mnemonicParsing="false" onAction="#OnClickDashboard" text="Dashboard" />

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Financial Reports" />

    <HBox alignment="CENTER_LEFT" spacing="10.0">
      <Label text="Record ID:" />
      <TextField fx:id="recordIdField" prefHeight="25.0" prefWidth="66.0" />
        <Label text="Report Type" />
        <ComboBox fx:id="reportTypeComboBox" prefHeight="25.0" prefWidth="85.0" />
      <Label text="Amount:" />
      <TextField fx:id="amountField" prefHeight="25.0" prefWidth="89.0" />
        <Label text="Record Date:" />
        <DatePicker fx:id="recordDatePicker" prefHeight="25.0" prefWidth="140.0" />
        <Button onAction="#onSearchClick" text="Load Financial Records" />
    </HBox>

    <TableView fx:id="recordTable" prefHeight="220.0">
        <columns>
            <TableColumn fx:id="recordIdColumn" prefWidth="172.66665077209473" text="Record ID" />
            <TableColumn fx:id="categoryColumn" prefWidth="192.0000457763672" text="Report Type" />
            <TableColumn fx:id="amountColumn" prefWidth="213.99996948242188" text="Amount" />
            <TableColumn fx:id="dateColumn" prefWidth="253.3333740234375" text="Record Date" />
        </columns>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button onAction="#onVerifyClick" text="Verify Report Data" />
        <Button onAction="#onGenerateClick" text="Generate Report" />
    </HBox>

    <Label fx:id="validationLabel" style="-fx-text-fill: #b00020;" wrapText="true" />
</VBox>
