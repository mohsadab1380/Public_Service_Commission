<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="User_2411699_Controller.EvaluationReportsController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <Button mnemonicParsing="false" onAction="#OnClickDashboard" text="Dashboard" />

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Evaluation Reports" />

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Subject:" />
        <ComboBox fx:id="reportTypeComboBox" prefWidth="180.0" />
        <Label text="Candidate Roll no:" />
        <TextField fx:id="examNameField" prefHeight="25.0" prefWidth="86.0" />
      <Label text="Obtained Mark:" />
      <TextField fx:id="examNameField1" prefHeight="25.0" prefWidth="86.0" />
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button onAction="#onSearchClick" text="Add Evaluation Data" />
        <Button onAction="#onVerifyClick" text="Verify Report Information" />
        <Button onAction="#onGenerateClick" text="Generate Report" />
    </HBox>

    <TableView fx:id="scriptTable" prefHeight="200.0">
        <columns>
            <TableColumn fx:id="candidateRollColumn" prefWidth="188.66668128967285" text="Candidate Roll No." />
            <TableColumn fx:id="subjectColumn" prefWidth="186.66664123535156" text="Subject" />
            <TableColumn fx:id="obtainedMarksColumn" prefWidth="248.00003051757812" text="Obtained Marks" />
        </columns>
    </TableView>

    <Label fx:id="validationLabel" style="-fx-text-fill: #b00020;" wrapText="true" />

    <HBox alignment="CENTER_LEFT" spacing="10.0" />

    <Label fx:id="statusLabel" style="-fx-text-fill: #1b7f4b; -fx-font-weight: bold;" />
</VBox>
