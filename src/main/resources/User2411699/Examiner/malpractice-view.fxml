<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="User_2411699_Controller.MalpracticeController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <Button mnemonicParsing="false" onAction="#OnClickDashboard" text="Dashboard" />

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Examination Malpractice Reports" />

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button onAction="#onPendingClick" text="Add Cases" />
        <Button onAction="#onValidateClick" text="Validate Cases" />
        <Button onAction="#onNotifyClick" text="Notify Controller of Examinations" />
    </HBox>

    <TableView fx:id="caseTable" prefHeight="180.0">
        <columns>
            <TableColumn fx:id="caseIdColumn" prefWidth="122.66667366027832" text="Case ID" />
            <TableColumn fx:id="candidateRollColumn" prefWidth="162.6666488647461" text="Candidate Roll No." />
            <TableColumn fx:id="candidateNameColumn" prefWidth="151.33334350585938" text="Candidate Name" />
            <TableColumn fx:id="examCentreColumn" prefWidth="170.66665649414062" text="Exam Center" />
            <TableColumn fx:id="incidentTypeColumn" prefWidth="179.3333740234375" text="Incident Type" />
            <TableColumn fx:id="reportDateColumn" prefWidth="206.66656494140625" text="Report Date" />
        </columns>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="10.0" />

    <Label fx:id="validationLabel" style="-fx-text-fill: #b00020;" wrapText="true" />
    <Label fx:id="notificationLabel" />
    <Label fx:id="statusLabel" style="-fx-text-fill: #1b7f4b; -fx-font-weight: bold;" />
</VBox>
