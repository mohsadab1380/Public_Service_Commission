<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="User_2411699_Controller.ProgressReportController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <Button mnemonicParsing="false" onAction="#OnClickDashboard" text="Dashboard" />

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Evaluation Progress Report" />

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Examination" />
        <ComboBox fx:id="examComboBox" prefHeight="25.0" prefWidth="173.0" />
        <Label text="Subject" />
        <ComboBox fx:id="subjectComboBox" prefHeight="25.0" prefWidth="172.0" />
        <Label text="Report Period" />
        <ComboBox fx:id="periodComboBox" prefWidth="160.0" />
        <Button onAction="#onLoadClick" text="Load Progress" />
    </HBox>
   <TableView prefHeight="200.0" prefWidth="200.0">
     <columns>
       <TableColumn prefWidth="241.33335304260254" text="Examination Type" />
       <TableColumn minWidth="0.0" prefWidth="273.99993896484375" text="Subject" />
         <TableColumn minWidth="0.0" prefWidth="317.33331298828125" text="Report period" />
     </columns>
   </TableView>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button onAction="#onVerifyClick" text="Verify Report Data" />
        <Button onAction="#onGenerateClick" text="Generate Report" />
    </HBox>

    <Label fx:id="validationLabel" style="-fx-text-fill: #b00020;" wrapText="true" />

    <Label fx:id="statusLabel" style="-fx-text-fill: #1b7f4b; -fx-font-weight: bold;" />
</VBox>
