<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="User_2411699_Controller.ReevaluationController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <Button mnemonicParsing="false" onAction="#OnClickDashboard" text="Dashboard" />

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Re-evaluation Requests" />
   <AnchorPane prefHeight="78.0" prefWidth="707.0">
      <children>
         <Label layoutX="14.0" layoutY="14.0" text="Request Id:" />
         <Label layoutX="14.0" layoutY="46.0" text="Previous Mark:" />
         <Label layoutX="242.0" layoutY="14.0" text="Candidate Roll no:" />
         <Label layoutX="242.0" layoutY="46.0" text="Present Mark:" />
         <Label layoutX="495.0" layoutY="14.0" text="Subject:" />
         <TextField fx:id="requestIdTextField" layoutX="93.0" layoutY="10.0" prefHeight="25.0" prefWidth="117.0" />
         <TextField fx:id="previousMarkTextField" layoutX="92.0" layoutY="42.0" prefHeight="25.0" prefWidth="117.0" />
         <TextField fx:id="candidateRollTextField" layoutX="346.0" layoutY="10.0" prefHeight="25.0" prefWidth="117.0" />
         <TextField fx:id="presentMarkTextField" layoutX="321.0" layoutY="42.0" prefHeight="25.0" prefWidth="117.0" />
         <ComboBox fx:id="subjectComboBox" layoutX="544.0" layoutY="10.0" prefWidth="150.0" />
         <Button layoutX="490.0" layoutY="42.0" mnemonicParsing="false" onAction="#handleAddandLoad" prefHeight="25.0" prefWidth="199.0" text="Add &amp; Load Table" />
      </children>
   </AnchorPane>

    <TableView fx:id="requestTable" prefHeight="180.0">
        <columns>
            <TableColumn fx:id="requestIdColumn" prefWidth="110.0" text="Request ID" />
            <TableColumn fx:id="candidateRollColumn" prefWidth="150.0" text="Candidate Roll No." />
            <TableColumn fx:id="subjectColumn" prefWidth="180.0" text="Subject" />
            <TableColumn fx:id="previousMarksColumn" prefWidth="154.66659545898438" text="Previous Marks" />
            <TableColumn fx:id="PrersentColumn" prefWidth="162.0" text="Present Mark" />
        </columns>
    </TableView>

    <Label fx:id="candidateLabel" style="-fx-font-weight: bold;" />

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Updated Total Marks" />
        <TextField fx:id="updatedMarksTextField" prefWidth="100.0" />
        <Label text="Examiner Remarks" />
        <TextField fx:id="remarksTextField" prefWidth="420.0" />
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button onAction="#onVerifyClick" text="Verify Mark Calculation" />
        <Button onAction="#onSaveClick" text="Save Re-evaluation" />
    </HBox>

    <Label fx:id="validationLabel" style="-fx-text-fill: #b00020;" wrapText="true" />
    <Label fx:id="statusLabel" style="-fx-text-fill: #1b7f4b; -fx-font-weight: bold;" />
</VBox>
