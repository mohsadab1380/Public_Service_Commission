<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="User_2411699_Controller.RemarksController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <Button mnemonicParsing="false" onAction="#OnClickDashboard" text="Dashboard" />

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Remarks and Recommendations" />

    <TableView fx:id="candidateTable" prefHeight="190.0">
        <columns>
            <TableColumn fx:id="candidateRollColumn" prefWidth="150.0" text="Candidate Roll No." />
            <TableColumn fx:id="candidateNameColumn" prefWidth="180.0" text="Candidate Name" />
            <TableColumn fx:id="subjectColumn" prefWidth="180.0" text="Subject" />
        </columns>
    </TableView>

    <Label fx:id="candidateLabel" style="-fx-font-weight: bold;" />

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Recommendation" />
        <ComboBox fx:id="recommendationComboBox" prefWidth="240.0" />
    </HBox>

    <Label text="Remarks" />
    <TextArea fx:id="remarksArea" prefHeight="110.0" />

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button onAction="#onSaveClick" text="Save Remarks" />
    </HBox>
    <Label fx:id="statusLabel" style="-fx-text-fill: #1b7f4b; -fx-font-weight: bold;" />
</VBox>
