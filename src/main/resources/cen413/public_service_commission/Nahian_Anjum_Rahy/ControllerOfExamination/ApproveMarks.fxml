<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cen413.public_service_commission.Nahian_Anjum_Rahy.ControllerClass.ApproveMarksController">
        <children>
            <VBox prefHeight="600.0" prefWidth="900.0" spacing="10">
                <children>
                    <HBox alignment="CENTER_LEFT" prefHeight="50" prefWidth="900" spacing="20">
                        <children>
                            <Button fx:id="backButton" onAction="#handleBack" text=" Back" />
                            <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Approve Marks" />
                        </children>
                    </HBox>

                    <GridPane hgap="10" style="-fx-background-color: #f5f5f5; -fx-padding: 15px;" vgap="8">
                        <children>
                            <Label text="Exam:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                            <ComboBox fx:id="examComboBox" prefWidth="150" promptText="Select Exam" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                            <Label text="Subject:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                            <ComboBox fx:id="subjectComboBox" prefWidth="150" promptText="Select Subject" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                            <HBox spacing="10" GridPane.columnIndex="0" GridPane.columnSpan="4" GridPane.rowIndex="1">
                                <Button fx:id="searchButton" onAction="#handleSearch" text="Search" />
                                <Button fx:id="resetButton" onAction="#handleReset" text=" Reset" />
                                <Button fx:id="verifyAllButton" onAction="#handleVerifyAll" text=" Verify All" />
                                <Button fx:id="approveSelectedButton" onAction="#handleApproveSelected" text="Approve Selected" />
                                <Button fx:id="rejectSelectedButton" onAction="#handleRejectSelected" text="Reject" />
                            </HBox>

                            <Label fx:id="statusLabel" text="Ready" GridPane.columnIndex="0" GridPane.columnSpan="4" GridPane.rowIndex="2" />
                        </children>
               <columnConstraints>
                  <ColumnConstraints />
                  <ColumnConstraints />
                  <ColumnConstraints />
                  <ColumnConstraints />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>
                    </GridPane>

                    <TableView fx:id="marksTableView" prefHeight="280" prefWidth="880">
                        <columns>
                            <TableColumn fx:id="rollNumberColumn" prefWidth="100" text="Roll Number" />
                            <TableColumn fx:id="candidateNameColumn" prefWidth="150" text="Candidate" />
                            <TableColumn fx:id="subjectColumn" prefWidth="120" text="Subject" />
                            <TableColumn fx:id="mcqMarksColumn" prefWidth="80" text="MCQ" />
                            <TableColumn fx:id="writtenMarksColumn" prefWidth="80" text="Written" />
                            <TableColumn fx:id="vivaMarksColumn" prefWidth="80" text="Viva" />
                            <TableColumn fx:id="totalMarksColumn" prefWidth="80" text="Total" />
                            <TableColumn fx:id="statusColumn" prefWidth="100" text="Status" />
                            <TableColumn fx:id="actionColumn" prefWidth="108.7999267578125" text="Action" />
                        </columns>
                    </TableView>
                </children>
            </VBox>
        </children>
    </AnchorPane>
