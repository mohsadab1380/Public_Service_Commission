<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cen413.public_service_commission.Nahian_Anjum_Rahy.ControllerClass.CenterAllocationController">

        <children>
            <VBox prefHeight="665.0" prefWidth="931.0" spacing="10">
                <children>
                    <HBox alignment="CENTER_LEFT" prefHeight="50" prefWidth="900" spacing="20">
                        <children>
                            <Button fx:id="backButton" onAction="#handleBack" text="Back" />
                            <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text=" Center Allocation" />
                        </children>
                    </HBox>

                    <GridPane hgap="10" style="-fx-background-color: #f5f5f5; -fx-padding: 15px;" vgap="8">
                        <children>
                            <Label text="Select Exam:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                            <ComboBox fx:id="examComboBox" prefWidth="150" promptText="Select Exam" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                            <Label text="Total Candidates:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                            <Label fx:id="totalCandidatesLabel" prefHeight="18.0" prefWidth="53.0" text="1,247" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                            <HBox spacing="10" GridPane.columnIndex="0" GridPane.columnSpan="4" GridPane.rowIndex="1">
                                <Button fx:id="autoAllocateButton" onAction="#handleAutoAllocate" text=" Auto Allocate" />
                                <Button fx:id="generateAdmitCardsButton" onAction="#handleGenerateAdmitCards" text="Generate Admit Cards" />
                                <Button fx:id="exportAllocationButton" onAction="#handleExportAllocation" text="Export Report" />
                            </HBox>

                            <Label fx:id="statusLabel" text="Ready" GridPane.columnIndex="0" GridPane.columnSpan="4" GridPane.rowIndex="2" />
                        </children>
               <columnConstraints>
                  <ColumnConstraints />
                  <ColumnConstraints />
                  <ColumnConstraints />
                  <ColumnConstraints />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>
                    </GridPane>

                    <TableView fx:id="allocationTableView" prefHeight="275.0" prefWidth="889.0">
                        <columns>
                            <TableColumn fx:id="centerNameColumn" prefWidth="179.99997556209564" text="Center Name" />
                            <TableColumn fx:id="districtColumn" prefWidth="137.60000610351562" text="District" />
                            <TableColumn fx:id="totalAllocatedColumn" prefWidth="118.39996337890625" text="Allocated" />
                            <TableColumn fx:id="capacityColumn" prefWidth="132.79995727539062" text="Capacity" />
                            <TableColumn fx:id="utilizationColumn" prefWidth="137.5999755859375" text="Utilization %" />
                            <TableColumn fx:id="actionColumn" prefWidth="226.4000244140625" text="Action" />
                        </columns>
                    </TableView>
                </children>
            </VBox>
        </children>

</AnchorPane>
