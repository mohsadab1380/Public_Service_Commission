<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cen413.public_service_commission.Nahian_Anjum_Rahy.ControllerClass.ManageAppealController">
        <children>
            <VBox prefHeight="600.0" prefWidth="900.0" spacing="10">
                <children>
                    <HBox alignment="CENTER_LEFT" prefHeight="50" prefWidth="900" spacing="20">
                        <children>
                            <Button fx:id="backButton" onAction="#handleBack" text=" Back" />
                            <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text=" Manage Appeals" />
                        </children>
                    </HBox>

                    <GridPane hgap="10" style="-fx-background-color: #f5f5f5; -fx-padding: 10px;" vgap="8">
                        <children>
                            <Label text="Filter:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                            <ComboBox fx:id="statusComboBox" prefWidth="120" promptText="All Status" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                            <Button fx:id="searchButton" onAction="#handleSearch" text=" Search" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                            <Button fx:id="resetButton" onAction="#handleReset" text=" Reset" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                        </children>
               <columnConstraints>
                  <ColumnConstraints />
                  <ColumnConstraints />
                  <ColumnConstraints />
                  <ColumnConstraints />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints />
               </rowConstraints>
                    </GridPane>

                    <TabPane>
                        <tabs>
                            <Tab closable="false" text="Pending">
                                <content>
                                    <TableView fx:id="pendingAppealsTableView" prefHeight="300" prefWidth="880">
                                        <columns>
                                            <TableColumn fx:id="appealIdColumn" prefWidth="100" text="Appeal ID" />
                                            <TableColumn fx:id="applicantNameColumn" prefWidth="150" text="Applicant" />
                                            <TableColumn fx:id="subjectColumn" prefWidth="150" text="Subject" />
                                            <TableColumn fx:id="reasonColumn" prefWidth="200" text="Reason" />
                                            <TableColumn fx:id="filingDateColumn" prefWidth="120" text="Date" />
                                            <TableColumn fx:id="actionColumn" prefWidth="100" text="Action" />
                                        </columns>
                                    </TableView>
                                </content>
                            </Tab>
                            <Tab closable="false" text="Under Review">
                                <content>
                                    <TableView fx:id="underReviewTableView" prefHeight="300" prefWidth="880">
                                        <columns>
                                            <TableColumn prefWidth="155.99999389648428" text="Appeal ID" />
                                            <TableColumn prefWidth="149.60000610351562" text="Applicant" />
                                            <TableColumn prefWidth="181.5999755859375" text="Examiner" />
                                            <TableColumn prefWidth="147.20004272460938" text="Status" />
                                            <TableColumn prefWidth="267.199951171875" text="Action" />
                                        </columns>
                                    </TableView>
                                </content>
                            </Tab>
                            <Tab closable="false" text="Resolved">
                                <content>
                                    <TableView fx:id="resolvedTableView" prefHeight="300" prefWidth="880">
                                        <columns>
                                            <TableColumn prefWidth="148.79998168945303" text="Appeal ID" />
                                            <TableColumn prefWidth="207.99996948242188" text="Applicant" />
                                            <TableColumn prefWidth="268.0000915527344" text="Decision" />
                                            <TableColumn prefWidth="278.4000244140625" text="Date" />
                                        </columns>
                                    </TableView>
                                </content>
                            </Tab>
                        </tabs>
                    </TabPane>
                </children>
            </VBox>
        </children>
</AnchorPane>
