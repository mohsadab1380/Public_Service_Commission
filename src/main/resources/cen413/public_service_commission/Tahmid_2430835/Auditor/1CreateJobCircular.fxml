   <TextField fx:id="postTitleTF" layoutX="425.0" layoutY="94.0" />
   <TextField fx:id="vacancyCountTF" layoutX="425.0" layoutY="136.0" />
   <TextField fx:id="ageLimitTF" layoutX="98.0" layoutY="178.0" />
   <Label fx:id="messageLabel" alignment="CENTER_RIGHT" layoutX="319.0" layoutY="39.0" prefHeight="18.0" prefWidth="281.0" textAlignment="RIGHT" />

</AnchorPane>
