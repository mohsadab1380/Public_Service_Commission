<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="mainPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cen413.public_service_commission.Tahmid_2430835.Auditor.CreateJobCircular">

    <!-- Title Label -->
    <Label layoutX="216.0" layoutY="11.0" text="Create Job Circular">
      <font>
         <Font name="System Bold" size="18.0" />
      </font></Label>

    <!-- Circular ID -->
    <Label layoutX="20.0" layoutY="98.0" text="Circular ID:" />

    <!-- Post Title -->
    <Label layoutX="355.0" layoutY="99.0" text="Post Title:" />

    <!-- Department -->
    <Label layoutX="15.0" layoutY="140.0" text="Department:" />

    <!-- Vacancy Count -->
    <Label layoutX="321.0" layoutY="140.0" text="Vacancy Count:" />

    <!-- Job Description -->
    <Label layoutX="50.0" layoutY="250.0" text="Job Description:" />
    <TextArea fx:id="jobDescriptionTA" layoutX="156.0" layoutY="232.0" prefHeight="53.0" prefWidth="400.0" wrapText="true" />

    <!-- Eligibility Criteria -->
    <Label layoutX="45.0" layoutY="313.0" text="Eligibility Criteria:" />
    <TextArea fx:id="eligibilityCriteriaTA" layoutX="156.0" layoutY="295.0" prefHeight="53.0" prefWidth="400.0" wrapText="true" />

    <!-- Application Deadline -->
    <Label layoutX="290.0" layoutY="186.0" text="Application Deadline:" />
