<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="mainPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cen413.public_service_commission.Tahmid_2430835.Auditor.DiscrepancyReport">

    <!-- Title Label -->
    <Label layoutX="204.0" layoutY="9.0" text="Discrepancy Report">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>

    <!-- Circular ID Input -->
    <Label layoutX="20.0" layoutY="83.0" text="Circular ID:" />
    <TextField fx:id="circularIdTF" layoutX="120.0" layoutY="79.0" prefWidth="150.0" />

    <!-- Load Applicants Button -->
    <Button layoutX="290.0" layoutY="79.0" onAction="#loadApplicantsButtonOA" prefHeight="27.0" prefWidth="120.0" text="Load Applicants">
        <font>
            <Font name="System Bold" size="12.0" />
        </font>
    </Button>

    <!-- Back to Dashboard Button -->
    <Button layoutX="20.0" layoutY="343.0" onAction="#backToDashboardButtonOA" prefHeight="27.0" prefWidth="150.0" text="Back to Dashboard">
        <font>
            <Font name="System Bold" size="12.0" />
        </font>
    </Button>

    <!-- TableView for Applicants -->
    <TableView fx:id="applicantsTableView" layoutX="20.0" layoutY="123.0" prefHeight="200.0" prefWidth="560.0">
        <columns>
            <TableColumn fx:id="applicantIdCol" prefWidth="87.0" text="Applicant ID" />
            <TableColumn fx:id="nameCol" prefWidth="113.0" text="Name" />
            <TableColumn fx:id="phoneCol" prefWidth="100.0" text="Phone" />
            <TableColumn fx:id="emailCol" prefWidth="120.0" text="Email" />
            <TableColumn fx:id="ageCol" prefWidth="50.0" text="Age" />
            <TableColumn fx:id="examResultCol" prefWidth="90.0" text="Exam Result" />
            <TableColumn fx:id="statusCol" prefWidth="100.0" text="Status" />
        </columns>
    </TableView>

    <!-- Mark Discrepancy Button -->
    <Button layoutX="420.0" layoutY="343.0" onAction="#markDiscrepancyButtonOA" prefHeight="27.0" prefWidth="160.0" text="Mark as Discrepancy">
        <font>
            <Font name="System Bold" size="12.0" />
        </font>
    </Button>

    <!-- Status/Message Label -->
    <Label fx:id="messageLabel" alignment="CENTER_RIGHT" layoutX="245.0" layoutY="43.0" prefHeight="17.0" prefWidth="352.0" text="" textAlignment="RIGHT" textFill="#006400">
        <font>
            <Font size="12.0" />
        </font>
    </Label>

</AnchorPane>
