<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="mainPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cen413.public_service_commission.Tahmid_2430835.Auditor.ViewApplicantDetails">

    <!-- Title Label -->
    <Label layoutX="215.0" layoutY="9.0" text="View Applicant Details">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>

    <!-- Message Label -->
    <Label fx:id="messageLabel" alignment="CENTER_RIGHT" layoutX="245.0" layoutY="43.0" prefHeight="17.0" prefWidth="352.0" text="" textAlignment="RIGHT" textFill="#006400">
        <font>
            <Font size="12.0" />
        </font>
    </Label>

    <!-- Applicant ID Input -->
    <Label layoutX="20.0" layoutY="83.0" text="Applicant ID:" />
    <TextField fx:id="applicantIdTF" layoutX="120.0" layoutY="79.0" prefWidth="150.0" />

    <!-- Load Button -->
    <Button layoutX="290.0" layoutY="79.0" onAction="#loadButtonOA" prefHeight="27.0" prefWidth="120.0" text="Load">
        <font>
            <Font name="System Bold" size="12.0" />
        </font>
    </Button>

    <!-- Applicant Details Display -->
    <Label layoutX="20.0" layoutY="140.0" text="Applicant ID:" />
    <Label fx:id="applicantIdLabel" layoutX="150.0" layoutY="140.0" />

    <Label layoutX="20.0" layoutY="170.0" text="Name:" />
    <Label fx:id="nameLabel" layoutX="150.0" layoutY="170.0" />

    <Label layoutX="20.0" layoutY="200.0" text="Phone:" />
    <Label fx:id="phoneLabel" layoutX="150.0" layoutY="200.0" />

    <Label layoutX="20.0" layoutY="230.0" text="Email:" />
    <Label fx:id="emailLabel" layoutX="150.0" layoutY="230.0" />

    <Label layoutX="20.0" layoutY="260.0" text="Address:" />
    <Label fx:id="addressLabel" layoutX="150.0" layoutY="260.0" />

    <Label layoutX="20.0" layoutY="290.0" text="Age:" />
    <Label fx:id="ageLabel" layoutX="150.0" layoutY="290.0" />

    <Label layoutX="320.0" layoutY="140.0" text="Exam Result:" />
    <Label fx:id="examResultLabel" layoutX="450.0" layoutY="140.0" />

    <Label layoutX="320.0" layoutY="170.0" text="Circular ID:" />
    <Label fx:id="circularIdLabel" layoutX="450.0" layoutY="170.0" />

    <Label layoutX="320.0" layoutY="200.0" text="Status:" />
    <Label fx:id="statusLabel" layoutX="450.0" layoutY="200.0" />

    <Label layoutX="320.0" layoutY="230.0" text="Application Date:" />
    <Label fx:id="applicationDateLabel" layoutX="450.0" layoutY="230.0" />

    <!-- Back to Dashboard Button -->
    <Button layoutX="20.0" layoutY="343.0" onAction="#backToDashboardButtonOA" prefHeight="27.0" prefWidth="150.0" text="Back to Dashboard">
        <font>
            <Font name="System Bold" size="12.0" />
        </font>
    </Button>

</AnchorPane>