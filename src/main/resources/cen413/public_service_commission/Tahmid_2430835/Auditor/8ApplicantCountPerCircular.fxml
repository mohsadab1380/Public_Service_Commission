<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="mainPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cen413.public_service_commission.Tahmid_2430835.Auditor.ApplicantCountPerCircular">

    <!-- Title Label -->
    <Label layoutX="181.0" layoutY="10.0" text="Applicant Count per Circular">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>

    <!-- Message Label -->
    <Label fx:id="messageLabel" alignment="CENTER_RIGHT" layoutX="245.0" layoutY="43.0" prefHeight="17.0" prefWidth="352.0" text="" textAlignment="RIGHT" textFill="#006400">
        <font>
            <Font size="12.0" />
        </font>
    </Label>

    <!-- From Date -->
    <Label layoutX="20.0" layoutY="83.0" text="From Date:" />
    <DatePicker fx:id="fromDateDP" layoutX="100.0" layoutY="79.0" prefWidth="150.0" />

    <!-- To Date -->
    <Label layoutX="270.0" layoutY="83.0" text="To Date:" />
    <DatePicker fx:id="toDateDP" layoutX="340.0" layoutY="79.0" prefWidth="150.0" />

    <!-- Load Button -->
    <Button layoutX="510.0" layoutY="79.0" onAction="#loadButtonOA" prefHeight="27.0" prefWidth="80.0" text="Load">
        <font>
            <Font name="System Bold" size="12.0" />
        </font>
    </Button>

    <!-- TableView for Circulars -->
    <TableView fx:id="circularsTableView" layoutX="20.0" layoutY="123.0" prefHeight="160.0" prefWidth="560.0">
        <columns>
            <TableColumn fx:id="circularIdCol" prefWidth="150.0" text="Circular ID" />
            <TableColumn fx:id="postTitleCol" prefWidth="250.0" text="Post Title" />
            <TableColumn fx:id="departmentCol" prefWidth="160.0" text="Department" />
        </columns>
    </TableView>

    <!-- Show Total Applicant Button -->
    <Button layoutX="420.0" layoutY="305.0" onAction="#showTotalApplicantButtonOA" prefHeight="27.0" prefWidth="160.0" text="Show Total Applicant">
        <font>
            <Font name="System Bold" size="12.0" />
        </font>
    </Button>

    <!-- Total Applicant Count Label -->
    <Label layoutX="20.0" layoutY="310.0" text="Total Applicants:" />
    <Label fx:id="totalApplicantLabel" layoutX="150.0" layoutY="310.0" />

    <!-- Back to Dashboard Button -->
    <Button layoutX="20.0" layoutY="343.0" onAction="#backToDashboardButtonOA" prefHeight="27.0" prefWidth="150.0" text="Back to Dashboard">
        <font>
            <Font name="System Bold" size="12.0" />
        </font>
    </Button>

</AnchorPane>