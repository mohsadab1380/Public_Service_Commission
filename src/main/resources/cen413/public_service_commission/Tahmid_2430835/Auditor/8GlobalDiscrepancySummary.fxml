<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="mainPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cen413.public_service_commission.Tahmid_2430835.Auditor.GlobalDiscrepancySummary">

    <!-- Title Label -->
    <Label layoutX="181.0" layoutY="10.0" text="Global Discrepancy Report">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>

    <!-- Message Label -->
    <Label fx:id="messageLabel" alignment="CENTER_RIGHT" layoutX="245.0" layoutY="43.0" prefHeight="17.0" prefWidth="352.0" text="" textAlignment="RIGHT" textFill="#006400">
        <font>
            <Font size="12.0" />
        </font>
    </Label>
    <Label layoutX="20.0" layoutY="83.0" text="From Date:" />
    <DatePicker fx:id="fromDateDP" layoutX="100.0" layoutY="79.0" prefWidth="150.0" />

    <!-- To Date -->
    <Label layoutX="270.0" layoutY="83.0" text="To Date:" />
    <DatePicker fx:id="toDateDP" layoutX="340.0" layoutY="79.0" prefWidth="150.0" />

    <!-- Load Button -->
    <Button layoutX="510.0" layoutY="79.0" onAction="#loadButtonOA" prefHeight="27.0" prefWidth="80.0" text="Load">
        <font>
            <Font name="System Bold" size="12.0" />
        </font>
    </Button>

    <!-- TableView for Discrepancy Summary -->
    <TableView fx:id="discrepancyTableView" layoutX="20.0" layoutY="123.0" prefHeight="200.0" prefWidth="560.0">
        <columns>
            <TableColumn fx:id="applicantIdCol" prefWidth="257.0" text="Circular ID" />
            <TableColumn fx:id="nameCol" prefWidth="302.0" text="Number of Discrepancy" />
        </columns>
    </TableView>

    <!-- Back to Dashboard Button -->
    <Button layoutX="20.0" layoutY="343.0" onAction="#backToDashboardButtonOA" prefHeight="27.0" prefWidth="150.0" text="Back to Dashboard">
        <font>
            <Font name="System Bold" size="12.0" />
        </font>
    </Button>

</AnchorPane>
