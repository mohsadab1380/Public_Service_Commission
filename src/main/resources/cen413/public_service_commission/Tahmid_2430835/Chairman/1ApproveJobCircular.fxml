<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="mainPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cen413.public_service_commission.Tahmid_2430835.Chairman.ApproveJobCircular">

    <!-- Title Label -->
    <Label layoutX="202.0" layoutY="9.0" text="Approve Job Circular">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>

    <!-- Message Label -->
    <Label fx:id="messageLabel" alignment="CENTER_RIGHT" layoutX="245.0" layoutY="43.0" prefHeight="17.0" prefWidth="352.0" text="" textAlignment="RIGHT" textFill="#006400">
        <font>
            <Font size="12.0" />
        </font>
    </Label>

    <!-- Date and Time Input -->
    <Label layoutX="20.0" layoutY="83.0" text="Date:" />

    <!-- Fetch Button -->
    <Button layoutX="260.0" layoutY="79.0" onAction="#fetchButtonOA" prefHeight="27.0" prefWidth="160.0" text="Fetch Pending Circulars">
        <font>
            <Font name="System Bold" size="12.0" />
        </font>
    </Button>

    <!-- TableView for Pending Circulars -->
    <TableView fx:id="pendingCircularsTableView" layoutX="20.0" layoutY="123.0" prefHeight="160.0" prefWidth="560.0">
        <columns>
            <TableColumn fx:id="circularIdCol" prefWidth="80.0" text="Circular ID" />
            <TableColumn fx:id="postTitleCol" prefWidth="120.0" text="Post Title" />
            <TableColumn fx:id="departmentCol" prefWidth="100.0" text="Department" />
            <TableColumn fx:id="vacancyCountCol" prefWidth="80.0" text="Vacancy" />
            <TableColumn fx:id="postedByCol" prefWidth="80.0" text="Posted By" />
            <TableColumn fx:id="submissionDateCol" prefWidth="100.0" text="Status" />
        </columns>
    </TableView>

    <!-- Approve Button -->
    <Button layoutX="420.0" layoutY="343.0" onAction="#approveButtonOA" prefHeight="27.0" prefWidth="160.0" text="Approve">
        <font>
            <Font name="System Bold" size="12.0" />
        </font>
    </Button>

    <!-- Back to Dashboard Button -->
    <Button layoutX="20.0" layoutY="343.0" onAction="#backToDashboardButtonOA" prefHeight="27.0" prefWidth="150.0" text="Back to Dashboard">
        <font>
            <Font name="System Bold" size="12.0" />
        </font>
    </Button>
   <DatePicker fx:id="dateDP" layoutX="60.0" layoutY="79.0" prefHeight="27.0" prefWidth="160.0" />

</AnchorPane>
