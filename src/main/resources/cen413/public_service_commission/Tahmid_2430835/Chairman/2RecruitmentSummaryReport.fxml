<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="mainPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cen413.public_service_commission.Tahmid_2430835.Chairman.RecruitmentSummaryReport">

    <!-- Title Label -->
    <Label layoutX="185.0" layoutY="9.0" text="Recruitment Summary Report">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>

    <!-- Message Label -->
    <Label fx:id="messageLabel" alignment="CENTER_RIGHT" layoutX="245.0" layoutY="43.0" prefHeight="17.0" prefWidth="352.0" text="" textAlignment="RIGHT" textFill="#006400">
        <font>
            <Font size="12.0" />
        </font>
    </Label>

    <!-- Filter Form -->
    <Label layoutX="20.0" layoutY="96.0" text="Start Date:" />
    <DatePicker fx:id="startDateDP" layoutX="110.0" layoutY="92.0" prefWidth="150.0" />

    <Label layoutX="280.0" layoutY="96.0" text="End Date:" />
    <DatePicker fx:id="endDateDP" layoutX="370.0" layoutY="92.0" prefWidth="150.0" />

    <!-- Generate Report Button -->
    <Button layoutX="387.0" layoutY="343.0" onAction="#generateReportButtonOA" prefHeight="27.0" prefWidth="160.0" text="Generate Report">
        <font>
            <Font name="System Bold" size="12.0" />
        </font>
    </Button>

    <!-- Summary Statistics -->
    <Label layoutX="144.0" layoutY="170.0" text="Total Circulars Posted:">
      <font>
         <Font name="System Bold" size="18.0" />
      </font></Label>
    <Label fx:id="totalPostedLabel" layoutX="365.0" layoutY="170.0" text="0" textFill="#00008b">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>

    <Label layoutX="144.0" layoutY="202.0" text="Total Approved:" textFill="DARKGREEN">
      <font>
         <Font name="System Bold" size="18.0" />
      </font></Label>
    <Label fx:id="totalApprovedLabel" layoutX="365.0" layoutY="202.0" text="0" textFill="DARKGREEN">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>

    <Label layoutX="144.0" layoutY="235.0" text="Rejected Circulars:" textFill="RED">
      <font>
         <Font name="System Bold" size="18.0" />
      </font></Label>
    <Label fx:id="totalRejectedLabel" layoutX="365.0" layoutY="235.0" text="0" textFill="RED">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>

    <!-- Back to Dashboard Button -->
    <Button layoutX="20.0" layoutY="343.0" onAction="#backToDashboardButtonOA" prefHeight="27.0" prefWidth="150.0" text="Back to Dashboard">
        <font>
            <Font name="System Bold" size="12.0" />
        </font>
    </Button>

</AnchorPane>
