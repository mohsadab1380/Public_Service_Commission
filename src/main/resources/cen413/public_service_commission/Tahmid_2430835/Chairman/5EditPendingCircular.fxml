<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="mainPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cen413.public_service_commission.Tahmid_2430835.Chairman.EditPendingCircular">

    <!-- Title Label -->
    <Label layoutX="210.0" layoutY="9.0" text="Edit Pending Circular">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>

    <!-- Message Label -->
    <Label fx:id="messageLabel" alignment="CENTER_RIGHT" layoutX="245.0" layoutY="43.0" prefHeight="17.0" prefWidth="352.0" text="" textAlignment="RIGHT" textFill="#006400">
        <font>
            <Font size="12.0" />
        </font>
    </Label>

    <!-- Load Button -->
    <Button layoutX="300.0" layoutY="79.0" onAction="#loadButtonOA" prefHeight="27.0" prefWidth="160.0" text="Load Pending Circulars">
        <font>
            <Font name="System Bold" size="12.0" />
        </font>
    </Button>

    <!-- TableView for Pending Circulars -->
    <TableView fx:id="pendingCircularsTableView" layoutX="20.0" layoutY="123.0" prefHeight="130.0" prefWidth="560.0">
        <columns>
            <TableColumn fx:id="circularIdCol" prefWidth="80.0" text="Circular ID" />
            <TableColumn fx:id="postTitleCol" prefWidth="120.0" text="Post Title" />
            <TableColumn fx:id="departmentCol" prefWidth="100.0" text="Department" />
            <TableColumn fx:id="vacancyCountCol" prefWidth="80.0" text="Vacancy" />
            <TableColumn fx:id="deadlineCol" prefWidth="100.0" text="Deadline" />
            <TableColumn fx:id="statusCol" prefWidth="80.0" text="Status" />
        </columns>
    </TableView>

    <!-- Edit Button -->
    <Button layoutX="20.0" layoutY="268.0" onAction="#editButtonOA" prefHeight="27.0" prefWidth="150.0" text="Edit">
        <font>
            <Font name="System Bold" size="12.0" />
        </font>
    </Button>

    <!-- Save Button -->
    <Button layoutX="420.0" layoutY="343.0" onAction="#saveButtonOA" prefHeight="27.0" prefWidth="160.0" text="Save">
        <font>
            <Font name="System Bold" size="12.0" />
        </font>
    </Button>

    <!-- Back to Dashboard Button -->
    <Button layoutX="20.0" layoutY="343.0" onAction="#backToDashboardButtonOA" prefHeight="27.0" prefWidth="150.0" text="Back to Dashboard">
        <font>
            <Font name="System Bold" size="12.0" />
        </font>
    </Button>
   <Label layoutX="20.0" layoutY="83.0" text="Circular ID:" />
   <TextField fx:id="circularIDTF" layoutX="95.0" layoutY="79.0" prefHeight="27.0" prefWidth="142.0" />

</AnchorPane>
