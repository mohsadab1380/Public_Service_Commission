<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="mainPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cen413.public_service_commission.Tahmid_2430835.Chairman.ViewRejectedCirculars">

    <!-- Title Label -->
    <Label layoutX="215.0" layoutY="9.0" text="View Rejected Circulars">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>

    <!-- Message Label -->
    <Label fx:id="messageLabel" alignment="CENTER_RIGHT" layoutX="245.0" layoutY="43.0" prefHeight="17.0" prefWidth="352.0" text="" textAlignment="RIGHT" textFill="#006400">
        <font>
            <Font size="12.0" />
        </font>
    </Label>

    <!-- Load Button -->
    <Button layoutX="283.0" layoutY="81.0" onAction="#loadButtonOA" prefHeight="27.0" prefWidth="160.0" text="Load Rejected Circulars">
        <font>
            <Font name="System Bold" size="12.0" />
        </font>
    </Button>

    <!-- TableView for Rejected Circulars -->
    <TableView fx:id="rejectedCircularsTableView" layoutX="20.0" layoutY="123.0" prefHeight="200.0" prefWidth="560.0">
        <columns>
            <TableColumn fx:id="circularIdCol" prefWidth="80.0" text="Circular ID" />
            <TableColumn fx:id="postTitleCol" prefWidth="120.0" text="Post Title" />
            <TableColumn fx:id="departmentCol" prefWidth="100.0" text="Department" />
            <TableColumn fx:id="submissionDateCol" prefWidth="90.0" text="Submission Date" />
            <TableColumn fx:id="rejectedByCol" prefWidth="90.0" text="Rejected By" />
            <TableColumn fx:id="rejectionReasonCol" prefWidth="120.0" text="Rejection Reason" />
            <TableColumn fx:id="rejectionDateCol" prefWidth="90.0" text="Rejection Date" />
        </columns>
    </TableView>

    <!-- Back to Dashboard Button -->
    <Button layoutX="20.0" layoutY="343.0" onAction="#backToDashboardButtonOA" prefHeight="27.0" prefWidth="150.0" text="Back to Dashboard">
        <font>
            <Font name="System Bold" size="12.0" />
        </font>
    </Button>
   <DatePicker fx:id="dateDP" layoutX="66.0" layoutY="81.0" prefHeight="27.0" prefWidth="168.0" />
   <Label layoutX="20.0" layoutY="85.0" text="Date: " />

</AnchorPane>
