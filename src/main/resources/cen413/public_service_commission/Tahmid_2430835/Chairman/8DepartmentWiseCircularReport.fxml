<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="mainPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cen413.public_service_commission.Tahmid_2430835.Chairman.DepartmentWiseCircularReport">

    <!-- Title Label -->
    <Label layoutX="190.0" layoutY="9.0" text="Department-wise Circular Report">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>

    <!-- Message Label -->
    <Label fx:id="messageLabel" alignment="CENTER_RIGHT" layoutX="245.0" layoutY="43.0" prefHeight="17.0" prefWidth="352.0" text="" textAlignment="RIGHT" textFill="#006400">
        <font>
            <Font size="12.0" />
        </font>
    </Label>

    <!-- Generate Report Button -->
    <Button layoutX="420.0" layoutY="77.0" onAction="#generateReportButtonOA" prefHeight="27.0" prefWidth="160.0" text="Generate Report">
        <font>
            <Font name="System Bold" size="12.0" />
        </font>
    </Button>

    <!-- TableView for Department-wise Report -->
    <TableView fx:id="departmentReportTableView" layoutX="20.0" layoutY="123.0" prefHeight="200.0" prefWidth="560.0">
        <columns>
            <TableColumn fx:id="departmentNameCol" prefWidth="300.0" text="Department Name" />
            <TableColumn fx:id="totalCircularsCol" prefWidth="260.0" text="Total Circulars Posted" />
        </columns>
    </TableView>

    <!-- Back to Dashboard Button -->
    <Button layoutX="20.0" layoutY="343.0" onAction="#backToDashboardButtonOA" prefHeight="27.0" prefWidth="150.0" text="Back to Dashboard">
        <font>
            <Font name="System Bold" size="12.0" />
        </font>
    </Button>
   <Label layoutX="20.0" layoutY="82.0" text="From:" />
   <DatePicker fx:id="fromDateDP" layoutX="58.0" layoutY="77.0" prefHeight="27.0" prefWidth="132.0" />
   <Label layoutX="201.0" layoutY="81.0" text="To: " />
   <DatePicker fx:id="toDateDP" layoutX="223.0" layoutY="78.0" prefHeight="27.0" prefWidth="144.0" />

</AnchorPane>
