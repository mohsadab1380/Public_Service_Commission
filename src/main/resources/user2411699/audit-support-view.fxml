<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="user_2411699_controller.AuditSupportController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Audit Support"/>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button onAction="#onLoadClick" text="Load Audit Records"/>
        <Button onAction="#onGenerateClick" text="Generate Audit Report"/>
        <Button onAction="#onUpdateClick" text="Update Financial Records"/>
        <Button onAction="#onCompleteClick" text="Complete Audit Support"/>
    </HBox>

    <TableView fx:id="auditTable" prefHeight="180.0">
        <columns>
            <TableColumn fx:id="voucherIdColumn" prefWidth="120.0" text="Voucher ID"/>
            <TableColumn fx:id="transactionIdColumn" prefWidth="130.0" text="Transaction ID"/>
            <TableColumn fx:id="headColumn" prefWidth="150.0" text="Head of Account"/>
            <TableColumn fx:id="amountColumn" prefWidth="120.0" text="Amount"/>
            <TableColumn fx:id="auditStatusColumn" prefWidth="120.0" text="Audit Status"/>
        </columns>
    </TableView>

    <Label style="-fx-font-weight: bold;" text="Audit Documents"/>
    <ListView fx:id="documentListView" prefHeight="90.0"/>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Audit Remarks"/>
        <TextField fx:id="remarksField" prefWidth="520.0" promptText="Correction applied to the accounting entry"/>
    </HBox>

    <Label fx:id="validationLabel" style="-fx-text-fill: #b00020;" wrapText="true"/>

    <Label style="-fx-font-weight: bold;" text="Audit Report"/>
    <TextArea fx:id="reportArea" prefHeight="160.0"/>

    <Label fx:id="statusLabel" style="-fx-text-fill: #1b7f4b; -fx-font-weight: bold;"/>
</VBox>
