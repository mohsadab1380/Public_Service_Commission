<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="user_2411699_controller.BudgetManagementController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Budget Management"/>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Department"/>
        <ComboBox fx:id="departmentComboBox" prefWidth="180.0"/>
        <Label text="Financial Period"/>
        <ComboBox fx:id="periodComboBox" prefWidth="160.0"/>
        <Button onAction="#onSearchClick" text="Load Budget Records"/>
        <Button onAction="#onGenerateReportClick" text="Generate Budget Utilization Report"/>
    </HBox>

    <Label style="-fx-font-weight: bold;" text="Budget Records"/>
    <TableView fx:id="budgetTable" prefHeight="150.0">
        <columns>
            <TableColumn fx:id="departmentColumn" prefWidth="180.0" text="Department Name"/>
            <TableColumn fx:id="allocatedColumn" prefWidth="140.0" text="Allocated Budget"/>
            <TableColumn fx:id="usedColumn" prefWidth="140.0" text="Used Budget"/>
            <TableColumn fx:id="remainingColumn" prefWidth="140.0" text="Remaining Budget"/>
            <TableColumn fx:id="utilisationColumn" prefWidth="130.0" text="Utilization %"/>
        </columns>
    </TableView>

    <Label style="-fx-font-weight: bold;" text="Expenditure Requests"/>
    <TableView fx:id="requestTable" prefHeight="150.0">
        <columns>
            <TableColumn fx:id="requestIdColumn" prefWidth="110.0" text="Request ID"/>
            <TableColumn fx:id="requestDepartmentColumn" prefWidth="150.0" text="Department"/>
            <TableColumn fx:id="purposeColumn" prefWidth="200.0" text="Purpose"/>
            <TableColumn fx:id="amountColumn" prefWidth="120.0" text="Amount"/>
            <TableColumn fx:id="requestedByColumn" prefWidth="180.0" text="Requested By"/>
            <TableColumn fx:id="requestStatusColumn" prefWidth="110.0" text="Status"/>
        </columns>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button onAction="#onVerifyClick" text="Verify Expenditure Request"/>
        <Button onAction="#onApproveClick" text="Approve"/>
        <Button onAction="#onRejectClick" text="Reject"/>
    </HBox>

    <Label fx:id="validationLabel" style="-fx-text-fill: #b00020;" wrapText="true"/>
    <TextArea fx:id="reportArea" editable="false" prefHeight="150.0"/>
    <Label fx:id="statusLabel" style="-fx-text-fill: #1b7f4b; -fx-font-weight: bold;"/>
</VBox>
