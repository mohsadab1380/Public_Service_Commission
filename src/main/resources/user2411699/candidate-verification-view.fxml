<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="user_2411699_controller.CandidateVerificationController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Candidate Verification"/>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button onAction="#onPendingClick" text="Pending Verification"/>
        <Button onAction="#onVerifiedClick" text="Verified Candidates"/>
        <Button onAction="#onValidateClick" text="Verify Eligibility Requirements"/>
        <Button onAction="#onApproveClick" text="Approve"/>
        <Button onAction="#onRejectClick" text="Reject"/>
    </HBox>

    <TableView fx:id="applicationTable" prefHeight="200.0">
        <columns>
            <TableColumn fx:id="applicationIdColumn" prefWidth="130.0" text="Application ID"/>
            <TableColumn fx:id="candidateNameColumn" prefWidth="180.0" text="Candidate Name"/>
            <TableColumn fx:id="rollNumberColumn" prefWidth="150.0" text="Roll Number"/>
            <TableColumn fx:id="examNameColumn" prefWidth="200.0" text="Exam Name"/>
            <TableColumn fx:id="verificationStatusColumn" prefWidth="150.0" text="Verification Status"/>
        </columns>
    </TableView>

    <Label fx:id="candidateLabel" style="-fx-font-weight: bold;" wrapText="true"/>

    <Label style="-fx-font-weight: bold;" text="Uploaded Documents"/>
    <ListView fx:id="documentListView" prefHeight="110.0"/>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Rejection Reason"/>
        <TextField fx:id="reasonField" prefWidth="480.0" promptText="Required when the application is rejected"/>
    </HBox>

    <Label fx:id="validationLabel" style="-fx-text-fill: #b00020;" wrapText="true"/>
    <Label fx:id="statusLabel" style="-fx-text-fill: #1b7f4b; -fx-font-weight: bold;"/>
</VBox>
