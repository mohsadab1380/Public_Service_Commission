<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="user_2411699_controller.EvaluationReportsController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Evaluation Reports"/>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Report Type"/>
        <ComboBox fx:id="reportTypeComboBox" prefWidth="180.0"/>
        <Label text="Examination Name"/>
        <TextField fx:id="examNameField" prefWidth="220.0"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="From"/>
        <DatePicker fx:id="fromDatePicker"/>
        <Label text="To"/>
        <DatePicker fx:id="toDatePicker"/>
        <Button onAction="#onSearchClick" text="Load Evaluation Data"/>
        <Button onAction="#onVerifyClick" text="Verify Report Information"/>
        <Button onAction="#onGenerateClick" text="Generate Report"/>
    </HBox>

    <TableView fx:id="scriptTable" prefHeight="200.0">
        <columns>
            <TableColumn fx:id="candidateRollColumn" prefWidth="160.0" text="Candidate Roll No."/>
            <TableColumn fx:id="subjectColumn" prefWidth="180.0" text="Subject"/>
            <TableColumn fx:id="obtainedMarksColumn" prefWidth="140.0" text="Obtained Marks"/>
            <TableColumn fx:id="statusColumn" prefWidth="150.0" text="Evaluation Status"/>
        </columns>
    </TableView>

    <Label fx:id="validationLabel" style="-fx-text-fill: #b00020;" wrapText="true"/>

    <Label style="-fx-font-weight: bold;" text="Evaluation Summary"/>
    <TextArea fx:id="reportArea" editable="false" prefHeight="160.0"/>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button onAction="#onDownloadPdfClick" text="Download PDF"/>
        <Button onAction="#onDownloadExcelClick" text="Download Excel"/>
    </HBox>

    <Label fx:id="statusLabel" style="-fx-text-fill: #1b7f4b; -fx-font-weight: bold;"/>
</VBox>
