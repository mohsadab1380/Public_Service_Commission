<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="user_2411699_controller.FeeReconciliationController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Exam Fee Reconciliation"/>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="From"/>
        <DatePicker fx:id="fromDatePicker"/>
        <Label text="To"/>
        <DatePicker fx:id="toDatePicker"/>
        <Button onAction="#onSearchClick" text="Search"/>
        <Button onAction="#onVerifyClick" text="Verify Payment Records"/>
        <Button onAction="#onConfirmClick" text="Confirm Reconciliation"/>
    </HBox>

    <TableView fx:id="transactionTable" prefHeight="240.0">
        <columns>
            <TableColumn fx:id="applicantIdColumn" prefWidth="120.0" text="Applicant ID"/>
            <TableColumn fx:id="applicantNameColumn" prefWidth="160.0" text="Applicant Name"/>
            <TableColumn fx:id="transactionIdColumn" prefWidth="130.0" text="Transaction ID"/>
            <TableColumn fx:id="amountColumn" prefWidth="110.0" text="Payment Amount"/>
            <TableColumn fx:id="paymentDateColumn" prefWidth="130.0" text="Payment Date"/>
            <TableColumn fx:id="statusColumn" prefWidth="130.0" text="Payment Status"/>
        </columns>
    </TableView>

    <Label fx:id="validationLabel" style="-fx-text-fill: #b00020;" wrapText="true"/>

    <Label style="-fx-font-weight: bold;" text="Reconciliation Summary Report"/>
    <TextArea fx:id="summaryArea" editable="false" prefHeight="150.0"/>

    <Label fx:id="statusLabel" style="-fx-text-fill: #1b7f4b; -fx-font-weight: bold;"/>
</VBox>
