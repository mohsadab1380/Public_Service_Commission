<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="user_2411699_controller.FinancialReportsController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Financial Reports"/>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Report Type"/>
        <ComboBox fx:id="reportTypeComboBox" prefWidth="180.0"/>
        <Label text="From"/>
        <DatePicker fx:id="fromDatePicker"/>
        <Label text="To"/>
        <DatePicker fx:id="toDatePicker"/>
        <Button onAction="#onSearchClick" text="Load Financial Records"/>
    </HBox>

    <TableView fx:id="recordTable" prefHeight="220.0">
        <columns>
            <TableColumn fx:id="recordIdColumn" prefWidth="100.0" text="Record ID"/>
            <TableColumn fx:id="categoryColumn" prefWidth="100.0" text="Category"/>
            <TableColumn fx:id="headColumn" prefWidth="150.0" text="Head of Account"/>
            <TableColumn fx:id="descriptionColumn" prefWidth="280.0" text="Description"/>
            <TableColumn fx:id="amountColumn" prefWidth="120.0" text="Amount"/>
            <TableColumn fx:id="dateColumn" prefWidth="120.0" text="Record Date"/>
        </columns>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button onAction="#onVerifyClick" text="Verify Report Data"/>
        <Button onAction="#onGenerateClick" text="Generate Report"/>
        <Button onAction="#onDownloadClick" text="Download Report"/>
    </HBox>

    <Label fx:id="validationLabel" style="-fx-text-fill: #b00020;" wrapText="true"/>

    <Label style="-fx-font-weight: bold;" text="Report Preview"/>
    <TextArea fx:id="reportArea" editable="false" prefHeight="170.0"/>

    <Label fx:id="statusLabel" style="-fx-text-fill: #1b7f4b; -fx-font-weight: bold;"/>
</VBox>
