<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="user_2411699_controller.PayrollManagementController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Payroll Management"/>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Payroll Period"/>
        <ComboBox fx:id="periodComboBox" prefWidth="180.0"/>
        <Button onAction="#onSearchClick" text="Load Employee Payroll"/>
        <Button onAction="#onVerifyClick" text="Verify Payroll Information"/>
        <Button onAction="#onProcessClick" text="Process Payroll"/>
    </HBox>

    <TableView fx:id="payrollTable" prefHeight="230.0">
        <columns>
            <TableColumn fx:id="employeeIdColumn" prefWidth="90.0" text="Employee ID"/>
            <TableColumn fx:id="employeeNameColumn" prefWidth="150.0" text="Employee Name"/>
            <TableColumn fx:id="designationColumn" prefWidth="140.0" text="Designation"/>
            <TableColumn fx:id="basicSalaryColumn" prefWidth="100.0" text="Basic Salary"/>
            <TableColumn fx:id="allowancesColumn" prefWidth="95.0" text="Allowances"/>
            <TableColumn fx:id="deductionsColumn" prefWidth="95.0" text="Deductions"/>
            <TableColumn fx:id="attendanceColumn" prefWidth="95.0" text="Attendance"/>
            <TableColumn fx:id="netSalaryColumn" prefWidth="100.0" text="Net Salary"/>
            <TableColumn fx:id="processingStatusColumn" prefWidth="100.0" text="Status"/>
        </columns>
    </TableView>

    <Label fx:id="validationLabel" style="-fx-text-fill: #b00020;" wrapText="true"/>

    <Label style="-fx-font-weight: bold;" text="Salary Slip Preview"/>
    <TextArea fx:id="slipArea" editable="false" prefHeight="160.0"/>

    <Label fx:id="bankTransferLabel"/>
    <Label fx:id="statusLabel" style="-fx-text-fill: #1b7f4b; -fx-font-weight: bold;"/>
</VBox>
