<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="user_2411699_controller.ProgressReportController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Evaluation Progress Report"/>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Examination"/>
        <ComboBox fx:id="examComboBox" prefWidth="220.0"/>
        <Label text="Subject"/>
        <ComboBox fx:id="subjectComboBox" prefWidth="200.0"/>
        <Label text="Report Period"/>
        <ComboBox fx:id="periodComboBox" prefWidth="160.0"/>
        <Button onAction="#onLoadClick" text="Load Progress"/>
    </HBox>

    <Label fx:id="assignedLabel"/>
    <Label fx:id="evaluatedLabel"/>
    <Label fx:id="pendingLabel"/>
    <Label fx:id="completionLabel"/>
    <ProgressBar fx:id="completionBar" prefWidth="420.0" progress="0.0"/>
    <Label fx:id="averageTimeLabel"/>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button onAction="#onVerifyClick" text="Verify Report Data"/>
        <Button onAction="#onGenerateClick" text="Generate Report"/>
        <Label text="Export Format"/>
        <ComboBox fx:id="formatComboBox" prefWidth="120.0"/>
        <Button onAction="#onExportClick" text="Export Report"/>
    </HBox>

    <Label fx:id="validationLabel" style="-fx-text-fill: #b00020;" wrapText="true"/>

    <Label style="-fx-font-weight: bold;" text="Report Preview"/>
    <TextArea fx:id="reportArea" editable="false" prefHeight="170.0"/>

    <Label fx:id="statusLabel" style="-fx-text-fill: #1b7f4b; -fx-font-weight: bold;"/>
</VBox>
