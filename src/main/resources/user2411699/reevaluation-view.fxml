<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="user_2411699_controller.ReevaluationController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Re-evaluation Requests"/>

    <TableView fx:id="requestTable" prefHeight="180.0">
        <columns>
            <TableColumn fx:id="requestIdColumn" prefWidth="110.0" text="Request ID"/>
            <TableColumn fx:id="candidateRollColumn" prefWidth="150.0" text="Candidate Roll No."/>
            <TableColumn fx:id="subjectColumn" prefWidth="180.0" text="Subject"/>
            <TableColumn fx:id="previousMarksColumn" prefWidth="130.0" text="Previous Marks"/>
            <TableColumn fx:id="requestDateColumn" prefWidth="130.0" text="Request Date"/>
            <TableColumn fx:id="statusColumn" prefWidth="120.0" text="Status"/>
        </columns>
    </TableView>

    <Label fx:id="candidateLabel" style="-fx-font-weight: bold;"/>

    <Label style="-fx-font-weight: bold;" text="Question-wise Marks and Mark Distribution"/>
    <TextArea fx:id="scriptArea" editable="false" prefHeight="140.0"/>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Updated Total Marks"/>
        <TextField fx:id="updatedMarksField" prefWidth="100.0"/>
        <Label text="Examiner Remarks"/>
        <TextField fx:id="remarksField" prefWidth="420.0"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button onAction="#onVerifyClick" text="Verify Mark Calculation"/>
        <Button onAction="#onSaveClick" text="Save Re-evaluation"/>
    </HBox>

    <Label fx:id="validationLabel" style="-fx-text-fill: #b00020;" wrapText="true"/>
    <Label fx:id="statusLabel" style="-fx-text-fill: #1b7f4b; -fx-font-weight: bold;"/>
</VBox>
