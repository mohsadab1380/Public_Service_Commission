<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="user_2411699_controller.RemarksController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Remarks and Recommendations"/>

    <TableView fx:id="candidateTable" prefHeight="190.0">
        <columns>
            <TableColumn fx:id="candidateRollColumn" prefWidth="150.0" text="Candidate Roll No."/>
            <TableColumn fx:id="candidateNameColumn" prefWidth="180.0" text="Candidate Name"/>
            <TableColumn fx:id="subjectColumn" prefWidth="180.0" text="Subject"/>
            <TableColumn fx:id="statusColumn" prefWidth="150.0" text="Evaluation Status"/>
        </columns>
    </TableView>

    <Label fx:id="candidateLabel" style="-fx-font-weight: bold;"/>

    <Label style="-fx-font-weight: bold;" text="Recommendation History"/>
    <TextArea fx:id="historyArea" editable="false" prefHeight="110.0"/>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Recommendation"/>
        <ComboBox fx:id="recommendationComboBox" prefWidth="240.0"/>
        <Label fx:id="characterCounterLabel" text="0 characters"/>
    </HBox>

    <Label text="Remarks"/>
    <TextArea fx:id="remarksArea" prefHeight="110.0"/>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button onAction="#onSaveClick" text="Save Remarks"/>
    </HBox>

    <Label fx:id="validationLabel" style="-fx-text-fill: #b00020;" wrapText="true"/>
    <Label fx:id="statusLabel" style="-fx-text-fill: #1b7f4b; -fx-font-weight: bold;"/>
</VBox>
