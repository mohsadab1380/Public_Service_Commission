<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="user_2411699_controller.ResultSubmissionController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Result Submission"/>
    <Label text="Select one or more evaluated scripts (hold Ctrl or Shift for multiple selection)."/>

    <TableView fx:id="resultTable" prefHeight="240.0">
        <columns>
            <TableColumn fx:id="candidateRollColumn" prefWidth="140.0" text="Candidate Roll No"/>
            <TableColumn fx:id="candidateNameColumn" prefWidth="170.0" text="Candidate Name"/>
            <TableColumn fx:id="examNameColumn" prefWidth="200.0" text="Exam Name"/>
            <TableColumn fx:id="subjectColumn" prefWidth="160.0" text="Subject"/>
            <TableColumn fx:id="obtainedMarksColumn" prefWidth="120.0" text="Obtained Marks"/>
            <TableColumn fx:id="submissionStatusColumn" prefWidth="140.0" text="Submission Status"/>
        </columns>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button onAction="#onLoadClick" text="Load Evaluated Scripts"/>
        <Button onAction="#onVerifyClick" text="Verify Examination Results"/>
        <Button onAction="#onSubmitClick" text="Submit Results"/>
    </HBox>

    <Label style="-fx-font-weight: bold;" text="Candidate Details and Subject-wise Marks"/>
    <TextArea fx:id="detailsArea" editable="false" prefHeight="170.0"/>

    <Label fx:id="validationLabel" style="-fx-text-fill: #b00020;" wrapText="true"/>
    <Label fx:id="statusLabel" style="-fx-text-fill: #1b7f4b; -fx-font-weight: bold;"/>
</VBox>
