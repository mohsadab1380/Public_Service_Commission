<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="user_2411699_controller.SupplierPaymentController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Supplier Payment Management"/>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Supplier"/>
        <ComboBox fx:id="supplierComboBox" prefWidth="200.0"/>
        <Label text="From"/>
        <DatePicker fx:id="fromDatePicker"/>
        <Label text="To"/>
        <DatePicker fx:id="toDatePicker"/>
        <Button onAction="#onSearchClick" text="Load Pending Invoices"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button onAction="#onVerifyClick" text="Verify Supplier Payment Details"/>
        <Button onAction="#onProcessClick" text="Process Payment"/>
    </HBox>

    <TableView fx:id="invoiceTable" prefHeight="220.0">
        <columns>
            <TableColumn fx:id="invoiceIdColumn" prefWidth="110.0" text="Invoice ID"/>
            <TableColumn fx:id="supplierNameColumn" prefWidth="180.0" text="Supplier Name"/>
            <TableColumn fx:id="amountColumn" prefWidth="110.0" text="Amount"/>
            <TableColumn fx:id="dueDateColumn" prefWidth="120.0" text="Due Date"/>
            <TableColumn fx:id="procurementColumn" prefWidth="150.0" text="Procurement Approved"/>
            <TableColumn fx:id="deliveryColumn" prefWidth="150.0" text="Delivery Confirmed"/>
            <TableColumn fx:id="paymentStatusColumn" prefWidth="120.0" text="Payment Status"/>
        </columns>
    </TableView>

    <Label fx:id="validationLabel" style="-fx-text-fill: #b00020;" wrapText="true"/>

    <Label style="-fx-font-weight: bold;" text="Payment Voucher"/>
    <TextArea fx:id="voucherArea" editable="false" prefHeight="150.0"/>

    <Label fx:id="bankTransferLabel"/>
    <Label fx:id="statusLabel" style="-fx-text-fill: #1b7f4b; -fx-font-weight: bold;"/>
</VBox>
